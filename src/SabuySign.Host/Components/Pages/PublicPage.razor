@page "/"
@page "/{*Path}"
@inject PublicSite Site
<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <meta name="robots" content="@(Indexable ? "index,follow" : "noindex,follow")" />
    @if (Indexable) { <link rel="canonical" href="@Site.Url(CanonicalPath)" /> }
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content="DocNori" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
    @if (Indexable) { <meta property="og:url" content="@Site.Url(CanonicalPath)" /> }
    @if (NormalizedPath == "" || Tool?.Id == "fill-sign")
    {
        <script type="application/ld+json" nonce="@((string)HttpContext.Items["CspNonce"]!)">@((MarkupString)PublicStructuredData.Create(Site, CanonicalPath, Title, Description))</script>
    }
</HeadContent>
@if (NormalizedPath == "")
{
    <ToolHome />
}
else if (NormalizedPath == "sign-together")
{
    <ToolRuntime ToolId="fill-sign" @rendermode="InteractiveWebAssembly" />
}
else if (NormalizedPath == "sign")
{
    <ToolRuntime ToolId="sign" @rendermode="InteractiveWebAssembly" />
}
else if (Tool is { Available: true })
{
    <ToolRuntime ToolId="@Tool.Id" @rendermode="InteractiveWebAssembly" />
}
else if (Tool is not null)
{
    <ToolStart Tool="Tool" />
}
else
{
    <SiteNav />
    <main class="tool-start"><h1>ไม่พบเครื่องมือนี้</h1><p>ลิงก์อาจไม่ถูกต้อง กรุณาเลือกเครื่องมือจากหน้าแรก</p><a class="button button-blue" href="/">กลับไปเลือกเครื่องมือ</a></main>
}
@code {
    [Parameter] public string? Path { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private string NormalizedPath => (Path ?? "").TrimEnd('/');
    private DocumentTool? Tool => ToolCatalog.Tools.FirstOrDefault(t => NormalizedPath == $"tools/{t.Id}");
    private bool Indexable => NormalizedPath == "" || Tool is { Available: true };
    private string CanonicalPath => NormalizedPath == "" ? "/" : $"/tools/{Tool!.Id}";
    private string Title => Tool?.Id == "organize" ? "จัดหน้า PDF ออนไลน์ เรียง ลบ หมุน และเพิ่มหน้า — DocNori" : NormalizedPath == "" ? "เครื่องมือจัดการ PDF ออนไลน์ รองรับภาษาไทย — DocNori" : Tool?.Id == "compress-image" ? "ลดขนาดรูป JPG PNG ออนไลน์ฟรี — DocNori" : Tool?.Id == "merge" ? "รวมไฟล์ PDF ออนไลน์ฟรี จัดลำดับไฟล์ได้ — DocNori" : Tool?.Id == "pdf-to-word" ? "แปลง PDF เป็น Word ออนไลน์ สำหรับแก้ไขเอกสาร — DocNori" : Tool?.Id == "compress" ? "ลดขนาด PDF ออนไลน์ฟรี ไม่ต้องอัปโหลดไฟล์ — DocNori" : Tool?.Id == "word-to-pdf" ? "แปลง Word เป็น PDF ออนไลน์ฟรี รองรับภาษาไทย — DocNori" : Tool?.Id == "video-to-mp3" ? "แปลงวิดีโอเป็นเสียง MP3 ออนไลน์ฟรี — DocNori" : Tool?.Id == "video-to-gif" ? "แปลงวิดีโอเป็น GIF ออนไลน์ฟรี | MP4 เป็น GIF — DocNori" : Tool?.Id == "fill-sign" ? "กรอกข้อความและเซ็น PDF ออนไลน์ฟรี — DocNori" : Tool is not null ? $"{Tool.Name} — DocNori" : NormalizedPath == "sign-together" ? "เซ็นเอกสารร่วมกัน — DocNori" : NormalizedPath == "sign" ? "เซ็นบนมือถือ — DocNori" : "ไม่พบเครื่องมือ — DocNori";
    private string Description => Tool?.Id == "organize" ? "จัดหน้า PDF ออนไลน์ฟรี ลากเรียงหน้า ลบ หมุน ทำสำเนา เพิ่มหน้าว่าง และรวมหลายไฟล์ ดูตัวอย่างก่อนดาวน์โหลด ทำบนเครื่องคุณ ไม่ส่งเอกสารขึ้นเซิร์ฟเวอร์" : Tool?.Id == "compress-image" ? "ลดขนาด JPG และ PNG ออนไลน์ฟรี คงความกว้างและความสูงเดิม PNG ไม่ลดรายละเอียด JPG เลือกคุณภาพได้ เปรียบเทียบก่อนดาวน์โหลด แปลงบนเครื่อง ไม่ส่งรูปขึ้นเซิร์ฟเวอร์" : Tool?.Id == "merge" ? "รวมไฟล์ PDF ออนไลน์ฟรี จัดลำดับเอกสารแล้วดาวน์โหลดเป็นไฟล์เดียว รองรับ 2–20 ไฟล์ รวมไม่เกิน 25 MB และ 100 หน้า ทำบนเครื่องคุณ ไม่ต้องสมัครสมาชิก" : Tool?.Id == "pdf-to-word" ? "แปลง PDF เป็น Word ออนไลน์ ดึงข้อความไปแก้ไขใน DOCX แบบปกติฟรีบนเครื่อง รองรับรวม 25 MB / 100 หน้า หน้าสแกนเป็นรูปภาพ และตารางอาจต่างจากต้นฉบับ" : Tool?.Id == "compress" ? "ลดขนาด PDF ออนไลน์ฟรี เลือกคุณภาพ ดูตัวอย่างและขนาดก่อน–หลัง ไฟล์ไม่ถูกส่งขึ้นเซิร์ฟเวอร์ รองรับภาษาไทย สูงสุด 50 MB และ 100 หน้า ไม่ต้องสมัครสมาชิก" : Tool?.Id == "word-to-pdf" ? "แปลง Word เป็น PDF ออนไลน์ฟรี รองรับ DOC, DOCX ภาษาไทย ข้อความ รูปภาพ และตาราง สูงสุด 10 ไฟล์ ไฟล์ละ 50 MB ดูตัวอย่างก่อนดาวน์โหลด ไม่ต้องสมัครสมาชิก" : Tool?.Id == "video-to-gif" ? "แปลงวิดีโอเป็น GIF ออนไลน์ฟรี รองรับ MP4, MOV และ WebM เลือกช่วง ตัดคลิป ปรับขนาด และดาวน์โหลด GIF ได้เลย ไม่ต้องสมัครสมาชิก ไฟล์ส่งไปแปลงชั่วคราวและลบเมื่อออกจากหน้า" : Tool?.Id == "fill-sign" ? "เซ็น PDF ออนไลน์ฟรี กรอกข้อความภาษาไทย วาดลายเซ็นบนคอมพิวเตอร์หรือมือถือ แล้ววางบนเอกสาร ไม่ต้องสมัครสมาชิก เซ็นด้วยตัวเองบนเครื่อง หรือแชร์เอกสารที่เข้ารหัสเพื่อเซ็นร่วมกัน" : Tool?.Description ?? (NormalizedPath == "" ? "เครื่องมือจัดการ PDF ออนไลน์ รองรับการกรอกข้อความภาษาไทย เซ็นเอกสาร รวมไฟล์ แยกหน้า และแปลง PDF เป็น JPG ใช้งานผ่านเบราว์เซอร์ แล้วดาวน์โหลดไฟล์ไปใช้ได้เลย" : "เครื่องมือจัดการเอกสาร DocNori");
    protected override void OnParametersSet()
    {
        if (NormalizedPath != "" && NormalizedPath != "sign" && NormalizedPath != "sign-together" && Tool is null)
        {
            // Render the fallback document first; commit its real HTTP status with the headers.
            HttpContext.Response.OnStarting(() => { HttpContext.Response.StatusCode = StatusCodes.Status404NotFound; return Task.CompletedTask; });
        }
    }
}
