<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/file-source-picker.css"]" />
    <ImportMap AdditionalAttributes="ImportAttributes" />
    <HeadOutlet />
</head>
<body data-enhance-nav="false">
    <Routes />
    <script type="module" src="@Assets["js/site.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private IReadOnlyDictionary<string, object> ImportAttributes => new Dictionary<string, object> { ["nonce"] = (string)HttpContext.Items["CspNonce"]! };
}
