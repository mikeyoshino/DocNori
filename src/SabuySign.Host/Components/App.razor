<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="application-name" content="DocNori" />
    <meta name="apple-mobile-web-app-title" content="DocNori" />
    <meta name="theme-color" content="#1686ce" />
    <link rel="icon" type="image/x-icon" href="@Assets["favicon.ico"]" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="@Assets["favicon-32x32.png"]" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" sizes="any" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" sizes="180x180" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/file-source-picker.css"]" />
    <link rel="stylesheet" href="@Assets["css/conversion.css"]" />
    <link rel="stylesheet" href="@Assets["css/video-gif.css"]" />
    <link rel="stylesheet" href="@Assets["css/word-pdf.css"]" />
    <link rel="stylesheet" href="@Assets["css/compress.css"]" />
    <link rel="stylesheet" href="@Assets["css/image-tools.css"]" />
    <link rel="stylesheet" href="@Assets["css/editor.css"]" />
    <link rel="stylesheet" href="@Assets["css/dropdown.css"]" />
    <ImportMap AdditionalAttributes="ImportAttributes" />
    @if (!HttpContext.Request.Path.StartsWithSegments("/tools/split") && !HttpContext.Request.Path.StartsWithSegments("/tools/pdf-to-jpg") && !HttpContext.Request.Path.StartsWithSegments("/tools/merge") && !HttpContext.Request.Path.StartsWithSegments("/tools/jpg-to-pdf") && !HttpContext.Request.Path.StartsWithSegments("/tools/heic-to-jpg") && !HttpContext.Request.Path.StartsWithSegments("/tools/compress") && !HttpContext.Request.Path.StartsWithSegments("/sign-together") && !HttpContext.Request.Path.StartsWithSegments("/sign") && !HttpContext.Request.Path.StartsWithSegments("/tools/fill-sign") && !HttpContext.Request.Path.StartsWithSegments("/tools/pdf-to-word") && !HttpContext.Request.Path.StartsWithSegments("/tools/word-to-pdf") && !HttpContext.Request.Path.StartsWithSegments("/tools/video-to-gif") && !HttpContext.Request.Path.StartsWithSegments("/tools/video-to-mp3"))
    {
    <script nonce="@CspNonce" async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1030637351071742" crossorigin="anonymous"></script>
    }
    <HeadOutlet />
</head>
<body data-enhance-nav="false">
    <Routes />
    <script nonce="@CspNonce" type="module" src="@Assets["js/site.js"]"></script>
    <script nonce="@CspNonce" src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private string CspNonce => (string)HttpContext.Items["CspNonce"]!;
    private IReadOnlyDictionary<string, object> ImportAttributes => new Dictionary<string, object> { ["nonce"] = CspNonce };
}
