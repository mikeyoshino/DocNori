<section id="signing-panel" class="signing-panel" hidden aria-label="เซ็นเอกสารร่วมกัน">
    <div class="signing-panel-title"><Icon Name="users" /><h2>เซ็นร่วมกัน</h2></div>
    <span id="signing-state" class="signing-state"></span>
    <p id="signing-identity" class="field-help"></p>
    <button id="signing-share" class="button button-soft full"><Icon Name="link" /> แชร์ลิงก์</button>
    <div class="signing-draft-section"><h3>ลายเซ็นของฉัน</h3><p id="signing-pending" class="field-help"></p><div id="signing-points" class="signing-points"></div><button id="signing-add" class="button button-soft full"><Icon Name="pen" /> เพิ่มลายเซ็นของฉัน</button><button id="signing-submit" class="button button-blue full" disabled>ยืนยันลายเซ็น</button></div>
    <p id="signing-live" role="status" aria-atomic="true"></p>
    <div id="signing-activity" class="signing-activity"></div>
    <p id="signing-message" role="status"></p>
    <p id="signing-expiry" class="field-help"></p>
    <button id="signing-finish" class="button button-soft full"><Icon Name="lock" /> จบการเซ็น</button>
    <button id="signing-delete" class="button button-quiet full"><Icon Name="trash" /> ลบเอกสารและปิด session</button>
</section>
