<header class="site-navigation">
    <div class="site-navigation-inner">
        <a class="brand" href="/"><BrandLogo /></a>
        <button class="nav-mobile-toggle" type="button" aria-label="เปิดเมนูเครื่องมือ" aria-expanded="false" aria-controls="primary-tool-nav"><span aria-hidden="true">☰</span> เมนู</button>
        <nav id="primary-tool-nav" class="primary-tool-nav" aria-label="เมนูหลัก">
            <details class="nav-disclosure nav-organize">
                <summary>จัดการ PDF <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
                <div class="nav-dropdown organize-nav-dropdown"><ToolMenuGroup Title="จัดการ PDF" Category="organize" Items='InCategory("organize")' /></div>
            </details>
            <a class="primary-nav-link" href="/tools/compress">ลดขนาด PDF</a>
            <details class="nav-disclosure nav-convert">
                <summary>แปลง PDF <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
                <div class="nav-dropdown convert-dropdown">
                    <ToolMenuGroup Title="แปลงเป็น PDF" Category="convert" Items="ToPdf" />
                    <ToolMenuGroup Title="แปลงจาก PDF" Category="convert" Items="FromPdf" />
                </div>
            </details>
            <details class="nav-disclosure">
                <summary>เครื่องมือทั้งหมด <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
                <div class="nav-dropdown all-tools-dropdown">
                    <ToolMenuGroup Title="จัดการ PDF" Category="organize" Items='InCategory("organize")' />
                    <ToolMenuGroup Title="ลดขนาดไฟล์" Category="optimize" Items='InCategory("optimize")' />
                    <ToolMenuGroup Title="แปลงเป็น PDF" Category="convert" Items="ToPdf" />
                    <ToolMenuGroup Title="แปลงจาก PDF" Category="convert" Items="FromPdf" />
                    <ToolMenuGroup Title="รูปภาพ" Category="images" Items='InCategory("images")' />
                    <ToolMenuGroup Title="วิดีโอและเสียง" Category="media" Items='InCategory("media")' />
                    <ToolMenuGroup Title="แก้ไขและเซ็น" Category="edit" Items='InCategory("edit")' />
                </div>
            </details>
        </nav>
        <details class="nav-disclosure account-menu app-launcher">
            <summary aria-label="แอป DocNori" title="แอป DocNori">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.3" /><rect x="14" y="3" width="7" height="7" rx="1.3" /><rect x="3" y="14" width="7" height="7" rx="1.3" /><rect x="14" y="14" width="7" height="7" rx="1.3" /></svg>
            </summary>
            <div class="account-menu-panel launcher-panel">
                <h2 class="launcher-heading">แอป DocNori</h2>
                <a class="launcher-app" href="/templates" data-template-app aria-label="แม่แบบ PDF">
                    <span class="launcher-app-icon">
                        <svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M9 4h12l7 7v20H9a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="white" stroke="currentColor" stroke-width="1.7" /><path d="M21 4v8h7M12 17h11M12 23h5M12 27h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><rect x="18" y="21" width="12" height="9" rx="2" fill="#1686ce" /><path d="M21 24h6M24 24v4" stroke="white" stroke-width="1.3" stroke-linecap="round" /></svg>
                    </span>
                    <span><strong>แม่แบบ PDF</strong><small>เตรียมครั้งเดียว กรอกข้อมูลใช้ซ้ำ</small></span>
                    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </a>
                <div class="launcher-account">
                    <p data-account-email hidden></p>
                    <a href="/account/login" data-account-login><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></svg>เข้าสู่ระบบ</a>
                    <button type="button" data-account-logout hidden>ออกจากระบบ</button>
                    <p data-account-status role="status"></p>
                </div>
            </div>
        </details>
    </div>
</header>
@code {
    private static IEnumerable<DocumentTool> InCategory(string category) => ToolCatalog.Tools.Where(t => t.Category == category);
    private static IEnumerable<DocumentTool> ToPdf => InCategory("convert").Where(t => t.Id.EndsWith("-to-pdf", StringComparison.Ordinal));
    private static IEnumerable<DocumentTool> FromPdf => InCategory("convert").Where(t => t.Id.StartsWith("pdf-to-", StringComparison.Ordinal));
}
