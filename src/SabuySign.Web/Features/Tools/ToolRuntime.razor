@using SabuySign.Web.Features.PdfEditor
@using SabuySign.Web.Features.PdfMerge
@using SabuySign.Web.Features.PdfSplit
@using SabuySign.Web.Features.Signatures
@using SabuySign.Web.Features.PdfToJpg
@using SabuySign.Web.Features.PdfToWord
@switch (ToolId)
{
    case "fill-sign": <Editor /> break;
    case "merge": <Merge /> break;
    case "split": <Split /> break;
    case "pdf-to-word": <ConvertWord /> break;
    case "pdf-to-jpg": <ConvertJpg /> break;
    case "sign": <MobileSign /> break;
}
@code {
    [Parameter, EditorRequired] public string ToolId { get; set; } = default!;
}
