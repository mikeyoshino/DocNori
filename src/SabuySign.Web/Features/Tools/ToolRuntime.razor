@using SabuySign.Web.Features.PdfEditor
@using SabuySign.Web.Features.PdfOrganize
@using SabuySign.Web.Features.PdfMerge
@using SabuySign.Web.Features.PdfSplit
@using SabuySign.Web.Features.Signatures
@using SabuySign.Web.Features.PdfToJpg
@using SabuySign.Web.Features.PdfToWord
@using SabuySign.Web.Features.VideoGif
@using SabuySign.Web.Features.VideoAudio
@using SabuySign.Web.Features.WordToPdf
@using SabuySign.Web.Features.PdfCompress
@using SabuySign.Web.Features.ImageTools
@switch (ToolId)
{
    case "compress-image": <CompressImages /> break;
    case "jpg-to-pdf": <ImageWorkbench Mode="pdf" /> break;
    case "heic-to-jpg": <ImageWorkbench Mode="heic" /> break;
    case "word-to-pdf": <WordToPdf /> break;
    case "fill-sign": <Editor /> break;
    case "video-to-mp3": <VideoAudio /> break;
    case "video-to-gif": <VideoGif /> break;
    case "organize": <Organize /> break;
    case "merge": <Merge /> break;
    case "compress": <Compress /> break;
    case "split": <Split /> break;
    case "pdf-to-word": <ConvertWord /> break;
    case "pdf-to-jpg": <ConvertJpg /> break;
    case "sign": <MobileSign /> break;
}
@code {
    [Parameter, EditorRequired] public string ToolId { get; set; } = default!;
}
