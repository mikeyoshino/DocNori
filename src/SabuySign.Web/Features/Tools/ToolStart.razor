<PageTitle>@(Tool.Id == "fill-sign" ? "กรอกข้อความและเซ็น PDF ออนไลน์ฟรี" : Tool.Name) — DocNory</PageTitle>
<SiteNav />
<main class="tool-start category-@Tool.Category">
    <nav class="tool-breadcrumb" aria-label="เส้นทางนำทาง"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><span>@Tool.Name</span></nav>
    <section class="tool-start-intro">
        <span class="tool-card-icon"><ToolArtwork Name="@Tool.Icon" /></span>
        <h1>@(Tool.Id == "fill-sign" ? "กรอกข้อความภาษาไทยและเซ็น PDF ออนไลน์" : Tool.Name)</h1>
        @if (Tool.Id == "fill-sign")
        {
            <p>วางลายเซ็นและเพิ่มข้อความภาษาไทยลงใน PDF ได้จากเบราว์เซอร์ ไม่ต้องสมัครสมาชิก เมื่อเสร็จแล้วตรวจไฟล์และดาวน์โหลดกลับไปใช้</p>
        }
        else
        {
            <p>@Tool.Description</p>
        }
        @if (Tool.Available)
        {
            <div id="drop-zone" class="tool-file-drop" role="region" aria-label="พื้นที่เปิด PDF">
                <Icon Name="upload" /><h2>เลือก PDF ที่ต้องการกรอกหรือเซ็น</h2>
                <p>ลากไฟล์มาวางที่นี่ หรือเลือกจากเครื่องของคุณ</p>
                <button class="button button-blue" @onclick="OnOpenPdf" disabled="@(!Ready || Busy)">@(Busy ? "กำลังเปิดเอกสาร…" : "เลือกไฟล์ PDF") <Icon Name="arrow" /></button>
                <span class="file-limits">PDF · สูงสุด 25 MB / 100 หน้า</span>
            </div>
            <p class="tool-local-note"><Icon Name="lock" /> เซ็นด้วยตัวเองบนเครื่อง · แชร์เอกสารที่เข้ารหัสเมื่อเลือกเซ็นหลายคน</p>
        }
        else
        {
            <div class="tool-coming-soon"><span class="tool-availability">เร็ว ๆ นี้</span><h2>เครื่องมือนี้กำลังพัฒนา</h2><p>ยังไม่เปิดรับไฟล์ในขณะนี้<br />คุณสามารถใช้เครื่องมือกรอกและเซ็น PDF ได้แล้ววันนี้</p><a class="button button-dark" href="/tools/fill-sign">ไปที่กรอกและเซ็น PDF <Icon Name="arrow" /></a></div>
        }
    </section>
    @if (Tool.Available)
    {
        <section class="tool-instructions" aria-labelledby="tool-how-heading"><h2 id="tool-how-heading">เซ็น PDF ออนไลน์ใน 3 ขั้นตอน</h2><div class="steps"><article><span class="step-number">01</span><h3>เปิดไฟล์ PDF</h3><p>เลือกเอกสารจากเครื่อง<br />ไฟล์จะเปิดในพื้นที่แก้ไข</p></article><article><span class="step-number">02</span><h3>สร้างและวางลายเซ็น</h3><p>วาดลายเซ็นบนคอมพิวเตอร์ หรือสแกน QR Code เพื่อวาดบนมือถือ จากนั้นลากลายเซ็นไปวางบน PDF และเพิ่มข้อความได้</p></article><article><span class="step-number">03</span><h3>ตรวจแล้วดาวน์โหลด</h3><p>ดูตัวอย่างผลลัพธ์จริง<br />ดาวน์โหลดก่อนปิดหรือรีเฟรชหน้า</p></article></div></section>
        <section class="tool-information" aria-labelledby="tool-information-heading">
            <h2 id="tool-information-heading">ก่อนนำเอกสารไปใช้</h2>
            <div class="tool-information-grid">
                <article><h3>ลายเซ็นที่เพิ่มเป็นแบบไหน?</h3><p>เครื่องมือนี้วางภาพลายเซ็นที่คุณวาดลงบน PDF ไม่ใช่ลายเซ็นดิจิทัลที่ใช้ใบรับรอง หากผู้รับเอกสารกำหนดวิธีเซ็นเฉพาะ ให้ตรวจข้อกำหนดของผู้รับก่อนส่ง</p></article>
                <article><h3>เอกสารของคุณอยู่ที่ไหน?</h3><p>หากเซ็นด้วยตัวเอง เอกสารจะอยู่บนเครื่องของคุณ หากเลือกเซ็นหลายคน เราจะเก็บเอกสารที่เข้ารหัสไว้ชั่วคราว 7 วัน หลังเจ้าของจบการเซ็นจะดาวน์โหลดได้อีก 24 ชั่วโมง แล้วลบอัตโนมัติ กุญแจเปิดเอกสารอยู่ในลิงก์ จึงควรส่งให้เฉพาะคนที่คุณต้องการให้เข้าถึง</p></article>
            </div>
        </section>
        @if (Tool.Id == "fill-sign")
        {
            <section class="tool-information" aria-labelledby="fill-sign-questions">
                <h2 id="fill-sign-questions">คำถามเกี่ยวกับการกรอกและเซ็น PDF</h2>
                <div class="tool-information-grid">
                    <article><h3>กรอกข้อความภาษาไทยใน PDF ได้ไหม?</h3><p>พิมพ์ข้อความลง PDF ได้ทั้งภาษาไทยและอังกฤษ เพื่อกรอกชื่อ ที่อยู่ และรายละเอียดเมื่อต้องกรอกแบบฟอร์ม PDF เป็นการเพิ่มข้อความบนหน้าเอกสาร ไม่ใช่การแก้ไขข้อความเดิมในไฟล์ ตรวจตำแหน่งและข้อความในตัวอย่างก่อนดาวน์โหลดทุกครั้ง</p></article>
                    <article><h3>เซ็น PDF ฟรีและต้องสมัครสมาชิกไหม?</h3><p>เครื่องมือกรอกและเซ็น PDF ใช้งานฟรี ไม่ต้องสมัครสมาชิก เปิดไฟล์ได้สูงสุด 25 MB และ 100 หน้า งานไม่มีการเก็บร่าง จึงควรดาวน์โหลดเอกสารที่เสร็จแล้วก่อนปิดหรือรีเฟรชหน้า</p></article>
                    <article><h3>ต้องเตรียมเอกสารหลายไฟล์ก่อนเซ็นอย่างไร?</h3><p>ใช้เครื่องมือ<a href="/tools/merge">รวมไฟล์ PDF ก่อนเซ็น</a> หากต้องการเอกสารฉบับเดียว หรือ<a href="/tools/split">แยกหน้า PDF ที่ต้องการเซ็น</a> แล้วนำไฟล์ที่ดาวน์โหลดมาเปิดในหน้านี้</p></article>
                </div>
            </section>
        }
    }
</main>
@code {
    [Parameter, EditorRequired] public DocumentTool Tool { get; set; } = default!;
    [Parameter] public bool Ready { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnOpenPdf { get; set; }
}
