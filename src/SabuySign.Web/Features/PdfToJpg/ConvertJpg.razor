@using SabuySign.Web.Features.Tools
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>PDF เป็น JPG — DocNori</PageTitle>
<SiteNav />
<main class="conversion-tool category-convert" @ref="Root">
    <section data-intro class="tool-start tool-start-intro conversion-intro">
        <span class="tool-card-icon"><ToolArtwork Name="to-jpg" /></span>
        <h1>PDF เป็น JPG</h1>
        <p>แปลงแต่ละหน้าเป็นรูป JPG หรือดึงรูปภาพที่อยู่ใน PDF<br />เลือกไฟล์ ตั้งค่าคุณภาพ แล้วดาวน์โหลดไปใช้ได้เลย</p>
        <div data-drop class="tool-file-drop">
            <Icon Name="upload" /><h2>เลือก PDF ที่ต้องการแปลงเป็นรูปภาพ</h2>
            <p>ลากไฟล์มาวางที่นี่ หรือเลือกจากเครื่องของคุณ</p>
            <button data-choose class="button button-blue" disabled="@(!Ready)">เลือกไฟล์ PDF <Icon Name="arrow" /></button>
            <span class="file-limits">1–20 ไฟล์ · ขนาดรวมไม่เกิน 25 MB / 100 หน้า</span>
        </div>
        <p class="tool-local-note"><Icon Name="lock" /> ไฟล์อยู่กับคุณ · ไม่ต้องสมัครสมาชิก</p>
        <section class="conversion-intro-help" aria-labelledby="jpg-how"><h2 id="jpg-how">แปลง PDF เป็นรูปภาพอย่างไร?</h2><p>เปิด PDF จากเครื่อง เลือกแปลงทุกหน้าหรือดึงเฉพาะรูปภาพ แล้วกด “แปลงเป็น JPG” หากมีหลายรูป คุณจะดาวน์โหลดเป็นไฟล์ ZIP เพื่อเก็บรูปทั้งหมดไว้ด้วยกัน</p></section>
    </section>
    <input data-files type="file" accept="application/pdf,.pdf" multiple disabled="@(!Ready)" hidden />
    <div data-workspace class="conversion-workspace" hidden>
        <section data-stage class="conversion-stage" aria-label="ไฟล์ PDF ที่จะแปลง">
            <div class="conversion-stage-heading"><h2>ไฟล์ที่เลือก</h2><span data-summary></span></div>
            <div class="conversion-add"><FileSourcePicker Label="เพิ่มไฟล์ PDF" ShowCloudOptions="false" /></div>
            <ul data-list class="conversion-files"></ul>
            <p class="conversion-stage-note">ลากไฟล์ PDF เพิ่มมาวางในพื้นที่นี้ได้</p>
        </section>
        <aside class="conversion-sidebar" aria-labelledby="jpg-options-heading">
            <h2 id="jpg-options-heading">ตัวเลือก PDF เป็น JPG</h2>
            <fieldset class="conversion-modes"><legend class="visually-hidden">วิธีแปลงเป็น JPG</legend>
                <label class="conversion-mode"><input type="radio" name="jpg-mode" value="pages" checked /><span class="conversion-option-icon"><ToolArtwork Name="to-jpg" /></span><span><strong>แปลงทุกหน้าเป็น JPG</strong><small data-page-count>หนึ่งรูปต่อหนึ่งหน้า</small></span><span class="conversion-selected" aria-hidden="true">✓</span></label>
                <label class="conversion-mode"><input type="radio" name="jpg-mode" value="images" /><span class="conversion-option-icon"><ToolArtwork Name="extract-images" /></span><span><strong>ดึงรูปภาพใน PDF</strong><small>บันทึกรูปที่ฝังในเอกสารเป็น JPG ไม่รวมข้อความหรือกราฟิกที่วาดด้วยเส้น</small></span><span class="conversion-selected" aria-hidden="true">✓</span></label>
            </fieldset>
            <fieldset data-quality class="conversion-quality"><legend>คุณภาพรูปภาพ</legend><div class="conversion-quality-options"><label><input type="radio" name="jpg-quality" value="normal" checked /><span><strong>ปกติ</strong><small>แนะนำ · ไฟล์เล็กกว่า</small></span></label><label><input type="radio" name="jpg-quality" value="high" /><span><strong>สูง</strong><small>ภาพละเอียดขึ้น</small></span></label></div></fieldset>
            <div class="conversion-settings-note"><p>ไฟล์ PDF ไม่ถูกส่งขึ้นเซิร์ฟเวอร์<br />พื้นที่โปร่งใสในภาพจะเป็นสีขาว</p><button data-clear type="button" class="conversion-clear">ล้างรายการไฟล์</button></div>
            <div data-footer class="conversion-footer"><button data-convert type="button" class="button button-blue">แปลงเป็น JPG <Icon Name="arrow" /></button></div>
        </aside>
    </div>
    <ConversionProgress Title="กำลังแปลง PDF เป็น JPG…" />
    <ConversionResult Title="แปลงเป็น JPG เรียบร้อยแล้ว" />
    <div data-feedback class="conversion-feedback"><p data-status role="status" aria-live="polite"></p><p data-error class="merge-error" role="alert" hidden></p></div>
</main>
@code {
    private ElementReference Root;
    private IJSObjectReference? Module;
    private bool Ready;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/convert-jpg.js");
        await Module.InvokeVoidAsync("init", Root);
        Ready = true;
        StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        if (Module is not null) { await Module.InvokeVoidAsync("dispose", Root); await Module.DisposeAsync(); }
    }
}
