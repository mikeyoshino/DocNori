@using SabuySign.Web.Features.Tools
@using SabuySign.Web.Features.Signatures
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>กรอกและเซ็น PDF — DocNory</PageTitle>
<input id="pdf-file" type="file" accept="application/pdf,.pdf" disabled="@(!Ready)" hidden />
<div class="landing" hidden="@State.Loaded">
    <ToolStart Tool="@(ToolCatalog.Tools.First(t => t.Id == "fill-sign"))" Ready="Ready" Busy="State.Busy" OnOpenPdf="Pick" />
</div>
<div class="editor-app" hidden="@(!State.Loaded)">
    <header class="editor-header"><button class="brand brand-button" @onclick="Close"><BrandLogo /></button><span class="header-divider"></span><div class="filename"><strong>@State.Filename</strong><span><span class="status-dot"></span> อยู่บนเครื่องนี้เท่านั้น</span></div><button class="button button-quiet small" @onclick="Pick" disabled="@(!Ready || State.Busy)"><Icon Name="upload" /> เปิดไฟล์ใหม่</button></header>
    <div class="editor-toolbar"><div class="tool-group"><button class="tool @(State.Tool == "select" ? "active" : "")" @onclick='() => Command("tool", "select")' title="เลือกข้อความ"><Icon Name="cursor" /> เลือก</button><button class="tool @(State.Tool.StartsWith("signature:", StringComparison.Ordinal) ? "คลิกบนเอกสารเพื่อวางลายเซ็น" : State.Tool == "text" ? "active" : "")" @onclick='() => Command("tool", "text")'><Icon Name="text" /> เพิ่มข้อความ</button></div><div class="tool-group"><button class="tool" @onclick='() => Command("signature")' disabled="@State.Busy">ลายเซ็น</button></div><div class="tool-group"><button class="tool icon-only" aria-label="ย้อนกลับ" title="ย้อนกลับ (Ctrl/⌘ Z)" disabled="@(!State.CanUndo || State.Busy)" @onclick='() => Command("undo")'><Icon Name="undo" /></button><button class="tool icon-only" aria-label="ทำซ้ำ" title="ทำซ้ำ (Ctrl/⌘ Shift Z)" disabled="@(!State.CanRedo || State.Busy)" @onclick='() => Command("redo")'><Icon Name="redo" /></button></div><span class="toolbar-hint">@(State.Tool.StartsWith("signature:", StringComparison.Ordinal) ? "คลิกบนเอกสารเพื่อวางลายเซ็น" : State.Tool == "text" ? "คลิกบนเอกสารเพื่อวางข้อความ" : "ดับเบิลคลิกข้อความเพื่อพิมพ์ · ลากแถบด้านบนเพื่อย้าย")</span><label class="zoom-label">ซูม <select aria-label="ระดับซูม" value="@State.Zoom" @onchange='e => Command("zoom", e.Value?.ToString())' disabled="@(!Ready || State.Busy)"><option value="0.5">50%</option><option value="0.75">75%</option><option value="1">100%</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></label></div>
    <div class="editor-body"><aside class="pages-panel"><div class="panel-title">หน้าเอกสาร <span>@State.Pages</span></div><div id="thumbnails"></div></aside><main class="workspace" aria-label="พื้นที่แก้ไขเอกสาร"><div class="workspace-caption">หน้า @State.Page / @State.Pages <span>PDF</span></div><div id="page-surface"><canvas id="page-canvas"></canvas><div id="text-layer"></div></div><div class="workspace-tip"><Icon Name="lock" /> ไม่บันทึกร่าง — ดาวน์โหลดก่อนปิดหน้านี้</div></main><aside class="properties-panel"><div class="panel-title"><Icon Name="text" /> ข้อความ</div>
            @if (State.Selected is { IsSignature: true } signature)
            {
                <div class="properties-content"><h3>ลายเซ็นที่เลือก</h3><p class="field-help">ลากแถบด้านบนเพื่อย้าย<br />ลากมุมล่างขวาเพื่อปรับขนาดโดยคงสัดส่วน</p><label>ความกว้าง<input aria-label="ความกว้างลายเซ็น" type="number" min="20" value="@Math.Round(signature.Width)" @onchange='e => Patch("width", e.Value?.ToString())' /></label><button class="button delete-button" @onclick='() => Command("delete")'><Icon Name="trash" /> ลบลายเซ็น</button></div>
            }
            else if (State.Selected is { } selected)
            {
                <div class="properties-content"><label>ข้อความที่เลือก<textarea aria-label="ข้อความที่เลือก" value="@selected.Text" @onchange='e => Patch("text", e.Value?.ToString())' rows="4"></textarea></label><label>ฟอนต์<select disabled><option>Sarabun · ภาษาไทย / English</option></select></label><div class="property-row"><label>ขนาดตัวอักษร<input aria-label="ขนาดตัวอักษร" type="number" min="8" max="72" value="@selected.Size" @onchange='e => Patch("size", e.Value?.ToString())' /></label><label>สีตัวอักษร<input aria-label="สีตัวอักษร" type="color" value="@selected.Color" @onchange='e => Patch("color", e.Value?.ToString())' /></label></div><label>การจัดแนว<select aria-label="การจัดแนว" value="@selected.Align" @onchange='e => Patch("align", e.Value?.ToString())'><option value="left">ชิดซ้าย</option><option value="center">กึ่งกลาง</option><option value="right">ชิดขวา</option></select></label><p class="field-help">กรอบปรับพอดีกับข้อความอัตโนมัติ<br />ปรับขนาดตัวอักษรจากช่องด้านบน<br />กด Enter เพื่อขึ้นบรรทัดใหม่</p><button class="button delete-button" @onclick='() => Command("delete")'><Icon Name="trash" /> ลบข้อความ</button></div>
            }
            else
            {
                <div class="properties-empty"><span class="empty-icon"><Icon Name="cursor" /></span><h3>เลือกข้อความเพื่อแก้ไข</h3><p>หรือกด “เพิ่มข้อความ”<br />แล้วคลิกบนหน้าเอกสาร</p><button class="button button-soft" @onclick='() => Command("tool", "text")'><Icon Name="text" /> เพิ่มข้อความ</button></div>
            }
            <div class="signature-library-panel"><div class="panel-title">ลายเซ็นของฉัน</div><div id="signature-library"></div><button class="button button-soft full" @onclick='() => Command("signature")' disabled="@State.Busy">สร้างลายเซ็น</button><p class="field-help">ลากลายเซ็นไปวาง หรือคลิกแล้วคลิกบน PDF<br />เก็บชั่วคราวจนกว่าจะปิดหน้านี้</p></div>
            <div class="export-panel"><span class="export-label">พร้อมนำเอกสารไปใช้?</span><button class="button button-blue full" disabled="@(!Ready || State.Busy)" @onclick='() => Command("preview")'><Icon Name="eye" /> @(State.Busy ? "กำลังเตรียม…" : "ดูตัวอย่าง PDF")</button><button class="button button-dark full" disabled="@(!Ready || State.Busy)" @onclick='() => Command("preview")'><Icon Name="download" /> ดาวน์โหลด PDF</button><p>ตรวจไฟล์ผลลัพธ์ก่อนดาวน์โหลด<br />ข้อความยังค้นหาและคัดลอกได้</p></div>
        </aside></div>
    <div class="editor-status"><span>@State.Count รายการ</span><span>@(State.Busy ? "กำลังประมวลผล…" : "ไม่มีการเก็บร่างอัตโนมัติ")</span><span>ไทย / English</span></div>
</div>
@if (!string.IsNullOrEmpty(State.Error))
{
    <div class="error-toast" role="alert"><span>@State.Error</span><button aria-label="ปิดข้อความแจ้งเตือน" @onclick='() => Command("clearError")'><Icon Name="close" /></button></div>
}
<dialog id="preview-dialog" aria-labelledby="preview-heading"><div class="preview-header"><div><h2 id="preview-heading">ตรวจเอกสารก่อนดาวน์โหลด</h2><p>ตัวอย่างจากไฟล์ PDF ที่จะดาวน์โหลดจริง</p></div><button class="tool" aria-label="ปิดตัวอย่าง" @onclick='() => Command("closePreview")'><Icon Name="close" /></button></div><div class="preview-toolbar"><button class="button button-quiet small" @onclick='() => Command("previewPrevious")'>หน้าก่อน</button><span id="preview-page-label"></span><button class="button button-quiet small" @onclick='() => Command("previewNext")'>หน้าถัดไป</button></div><div class="preview-body"><canvas id="preview-canvas"></canvas></div><div class="preview-footer"><button class="button button-quiet" @onclick='() => Command("closePreview")'>กลับไปแก้ไข</button><button class="button button-blue" @onclick='() => Command("download")'><Icon Name="download" /> ดาวน์โหลดไฟล์นี้</button></div></dialog>
<SignatureDialogs />
<div id="blazor-error-ui">เกิดข้อผิดพลาด กรุณาดาวน์โหลดงานถ้ายังทำได้ก่อนรีเฟรช <a href="/">โหลดหน้าใหม่</a></div>
@code {
    private IJSObjectReference? Module;
    private DotNetObjectReference<Editor>? Reference;
    private EditorState State = new();
    private bool Ready;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/index.js");
        Reference = DotNetObjectReference.Create(this);
        await Module.InvokeVoidAsync("init", Reference);
        Ready = true;
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public Task Changed(EditorState state) { State = state; return InvokeAsync(StateHasChanged); }
    private async Task Pick() { if (Module is not null) await Module.InvokeVoidAsync("pick"); }
    private Task Close() => Command("close");
    private async Task Command(string action, string? value = null) { if (Module is not null) await Module.InvokeVoidAsync("command", action, value); }
    private async Task Patch(string key, string? value) { if (Module is not null) await Module.InvokeVoidAsync("patch", key, value); }
    public async ValueTask DisposeAsync() { if (Module is not null) { await Module.InvokeVoidAsync("dispose"); await Module.DisposeAsync(); } Reference?.Dispose(); }
    public sealed class EditorState
    {
        public bool Loaded { get; set; }
        public bool Busy { get; set; }
        public string Filename { get; set; } = "";
        public string? Error { get; set; }
        public string Tool { get; set; } = "select";
        public int Pages { get; set; }
        public int Page { get; set; } = 1;
        public int Count { get; set; }
        public double Zoom { get; set; } = 1;
        public bool CanUndo { get; set; }
        public bool CanRedo { get; set; }
        public SelectedText? Selected { get; set; }
    }
    public sealed class SelectedText
    {
        public bool IsSignature { get; set; }
        public string Text { get; set; } = "";
        public double Size { get; set; }
        public string Color { get; set; } = "#172433";
        public string Align { get; set; } = "left";
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
