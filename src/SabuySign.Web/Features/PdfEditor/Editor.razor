@using SabuySign.Web.Features.SigningSessions
@using SabuySign.Web.Features.Tools
@using SabuySign.Web.Features.Signatures
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>กรอกข้อความและเซ็น PDF ออนไลน์ฟรี — DocNori</PageTitle>
<div id="signing-loading" class="signing-loading" hidden><h2 id="signing-loading-text">กำลังเปิดเอกสารสำหรับเซ็นร่วมกัน…</h2><a href="/tools/fill-sign">กลับไปเครื่องมือเซ็นเอกสาร</a></div>
<div id="signing-outcome" hidden>
    <SiteNav />
    <main class="signing-outcome-main" aria-labelledby="signing-outcome-title">
        <div class="signing-outcome-icon"><Icon Name="lock" /></div>
        <p class="eyebrow">เซ็นเอกสารร่วมกัน</p>
        <h2 id="signing-outcome-title" tabindex="-1"></h2>
        <p id="signing-outcome-description"></p>
        <p id="signing-outcome-drafts" class="signing-outcome-note" hidden>ลายเซ็นที่ยังไม่ยืนยันไม่ได้รวมอยู่ในเอกสาร</p>
        <p id="signing-outcome-expiry"></p>
        <div class="signing-outcome-actions">
            <button id="signing-outcome-download" class="button button-blue" @onclick='() => Command("preview")'><Icon Name="download" /> ดาวน์โหลด PDF</button>
            <a class="button button-soft" href="/tools/fill-sign">กลับไปเครื่องมือเซ็นเอกสาร</a>
        </div>
        <button id="signing-outcome-delete" class="button button-quiet" hidden><Icon Name="trash" /> ลบเอกสาร</button>
        <p id="signing-outcome-message" role="status"></p>
    </main>
</div>
<input id="pdf-file" type="file" accept="application/pdf,.pdf" disabled="@(!Ready)" hidden />
<div class="landing" hidden="@State.Loaded">
    <ToolStart Tool="@(ToolCatalog.Tools.First(t => t.Id == "fill-sign"))" Ready="Ready" Busy="State.Busy" OnOpenPdf="Pick" />
</div>
<div class="editor-app" hidden="@(!State.Loaded)">
    <header class="editor-header"><button class="brand brand-button" @onclick="Close"><BrandLogo /></button><span class="header-divider"></span><div class="filename"><strong>@State.Filename</strong><span>@(State.Shared ? "เซ็นร่วมกัน" : "กรอกและเซ็น PDF") · @State.Pages หน้า</span></div><div class="editor-header-actions">@if(State.Shared && !State.SharedExpired) { <button class="button button-soft small" @onclick='() => Command("share")'><Icon Name="link" /> แชร์</button> }<div class="editor-mobile-history"><button class="tool" aria-label="ย้อนกลับ" disabled="@(!State.CanUndo || State.Busy)" @onclick='() => Command("undo")'><Icon Name="undo" /></button><button class="tool" aria-label="ทำซ้ำ" disabled="@(!State.CanRedo || State.Busy)" @onclick='() => Command("redo")'><Icon Name="redo" /></button></div><button class="button button-quiet small open-another" @onclick="Pick" disabled="@(!Ready || State.Busy)"><Icon Name="upload" /> เปิดไฟล์ใหม่</button><button class="button button-quiet small header-preview" aria-label="ดูตัวอย่าง PDF" disabled="@(State.Busy || (State.Shared && (!State.SharedClosed || State.SharedExpired)))" @onclick='() => Command("preview")'><Icon Name="eye" /> ดูตัวอย่าง</button><button class="button button-blue small" aria-label="ดาวน์โหลด PDF" disabled="@(State.Busy || (State.Shared && (!State.SharedClosed || State.SharedExpired)))" @onclick='() => Command("preview")'><Icon Name="download" /> ดาวน์โหลด<span class="desktop-label"> PDF</span></button></div></header>
    <div class="editor-toolbar">
        <div class="tool-group editor-primary-tools">
            <button class="tool @(State.Tool == "select" && State.Selected?.IsMark != true && State.Selected?.Date is null ? "active" : "")" disabled="@State.Busy" @onclick='() => Command("tool", "select")'><Icon Name="cursor" /><span>เลือก</span></button>
            <button class="tool @(State.Tool == "text" ? "active" : "")" aria-label="เพิ่มข้อความ" disabled="@State.Busy" @onclick='() => Command("tool", "text")'><Icon Name="text" /><span>ข้อความ</span></button>
            <div class="mark-picker-wrap"><button class="tool @(State.Tool == "mark" || State.Selected?.IsMark == true ? "active" : "")" aria-expanded="@(MarkMenu ? "true" : "false")" aria-controls="mark-picker" disabled="@State.Busy" @onclick="ToggleMarks"><Icon Name="@State.MarkKind" /><span>เครื่องหมาย</span><span class="mark-chevron" aria-hidden="true">⌄</span></button>
                @if (MarkMenu)
                {
                    <div class="mark-picker" id="mark-picker"><p>เลือกเครื่องหมาย</p><MarkChoices Value="@State.MarkKind" Disabled="@State.Busy" OnChange="ChooseMark" /><small>เลือกแล้วคลิกบนเอกสารเพื่อวาง</small></div>
                }
            </div>
            <button class="tool @(ShowDate ? "active" : "")" aria-label="เพิ่มวันที่" disabled="@State.Busy" @onclick='() => Command("tool", "date")'><Icon Name="calendar" /><span>วันที่</span></button>
            <button class="tool @(State.Tool.StartsWith("signature:", StringComparison.Ordinal) ? "active" : "")" @onclick='() => Command("signature")' disabled="@State.Busy"><Icon Name="pen" /><span>เซ็นเอกสาร</span></button>
        </div>
        <div class="tool-group editor-history"><button class="tool icon-only" aria-label="ย้อนกลับ" title="ย้อนกลับ (Ctrl/⌘ Z)" disabled="@(!State.CanUndo || State.Busy)" @onclick='() => Command("undo")'><Icon Name="undo" /></button><button class="tool icon-only" aria-label="ทำซ้ำ" title="ทำซ้ำ (Ctrl/⌘ Shift Z)" disabled="@(!State.CanRedo || State.Busy)" @onclick='() => Command("redo")'><Icon Name="redo" /></button></div>
        <div class="zoom-label">ขนาดหน้า <Dropdown Label="ระดับซูม" Value="@ZoomValue" Options="@ZoomOptions" Disabled="@(!Ready || State.Busy)" CssClass="zoom-dropdown" ValueChanged='value => Command("zoom", value)' /></div>
    </div>
    <div class="editor-body"><aside class="pages-panel"><div class="panel-title">หน้าเอกสาร <span>@State.Pages</span></div><div id="thumbnails"></div></aside><main class="workspace" aria-label="พื้นที่แก้ไขเอกสาร" @onclick="() => MarkMenu = false"><div class="workspace-caption"><span class="desktop-page-label">หน้า @State.Page จาก @State.Pages</span><div class="mobile-page-select">หน้า <Dropdown Label="หน้าเอกสาร" Value="@State.Page.ToString()" Options="@PageOptions" Disabled="@State.Busy" CssClass="page-dropdown" ValueChanged='value => Command("page", value)' /></div><div class="mobile-page-select mobile-zoom">ซูม <Dropdown Label="ระดับซูมบนมือถือ" Value="@ZoomValue" Options="@MobileZoomOptions" Disabled="@State.Busy" CssClass="zoom-dropdown" ValueChanged='value => Command("zoom", value)' /></div><span class="workspace-privacy"><Icon Name="lock" /> @(State.Shared ? "เอกสารร่วมกัน · เข้ารหัส" : "ไฟล์อยู่บนเครื่องคุณ")</span></div><div id="page-surface"><canvas id="page-canvas"></canvas><div id="text-layer"></div></div><div class="workspace-tip"><Icon Name="lock" /> @(State.Shared ? "ลายเซ็นร่างจะปรากฏให้คนอื่นเห็นเมื่อกดยืนยัน" : "ไม่บันทึกร่าง — ดาวน์โหลดก่อนปิดหน้านี้")</div></main><aside class="properties-panel @(ShowMarks ? "mark-properties" : ShowDate ? "date-properties" : "")">
            <SigningPanel />
            @if (ShowDate)
            {
                <div class="date-properties-content">
                    <div class="date-panel-heading"><Icon Name="calendar" /><h2>@(State.Selected?.Date is not null ? "วันที่ที่เลือก" : "เพิ่มวันที่")</h2></div>
                    <p class="date-subtitle">เลือกวันที่และรูปแบบที่ใช้ในเอกสาร</p>
                    <div class="date-input-row"><label for="stamp-date">วันที่<input id="stamp-date" type="date" min="0001-01-01" max="9999-12-31" value="@State.Date.Value" disabled="@State.Busy" @onchange='e => Command("dateValue", e.Value?.ToString())' /></label><button class="button button-quiet" disabled="@State.Busy" @onclick='() => Command("dateToday")'>วันนี้</button></div>
                    <fieldset class="date-calendar"><legend>ปีที่แสดงบนเอกสาร</legend><div><button aria-pressed="@(State.Date.Calendar == "buddhist" ? "true" : "false")" disabled="@State.Busy" @onclick='() => Command("dateCalendar", "buddhist")'>พ.ศ.</button><button aria-pressed="@(State.Date.Calendar == "gregorian" ? "true" : "false")" disabled="@State.Busy" @onclick='() => Command("dateCalendar", "gregorian")'>ค.ศ.</button></div></fieldset>
                    <div class="date-format-label"><span>รูปแบบวันที่</span><Dropdown Id="stamp-format" Label="รูปแบบวันที่" Value="@State.Date.Format" Options="@DateFormatOptions" Disabled="@State.Busy" ValueChanged='value => Command("dateFormat", value)' /></div>
                    <div class="date-preview"><span>ตัวอย่างบนเอกสาร</span><output aria-live="polite" aria-label="ตัวอย่างวันที่">@State.DatePreview</output></div>
                    <div class="property-row date-style"><label>ขนาดตัวอักษร<input aria-label="ขนาดตัวอักษรวันที่" type="number" min="8" max="72" value="@State.DateSize" disabled="@State.Busy" @onchange='e => Command("dateSize", e.Value?.ToString())' /></label><label>สีตัวอักษร<input aria-label="สีตัวอักษรวันที่" type="color" value="@State.DateColor" disabled="@State.Busy" @onchange='e => Command("dateColor", e.Value?.ToString())' /></label></div>
                    <p class="date-placement-hint"><Icon Name="@(State.Selected?.Date is not null ? "move" : "cursor")" />@(State.Selected?.Date is not null ? "ลากวันที่เพื่อย้ายตำแหน่ง" : "คลิกบนเอกสารเพื่อวางวันที่")</p>
                    @if (State.Selected?.Date is not null)
                    {
                        <div class="date-actions"><button class="button button-soft" disabled="@State.Busy" @onclick='() => Command("tool", "date")'>วางอีกตำแหน่ง</button><button class="button button-quiet" aria-label="ลบวันที่" disabled="@State.Busy" @onclick='() => Command("delete")'><Icon Name="trash" /></button></div>
                    }
                    <button class="button button-quiet date-done" disabled="@State.Busy" @onclick='() => Command("finishDate")'>@(State.Selected?.Date is not null ? "เสร็จ" : "ยกเลิก")</button>
                </div>
            }
            else if (ShowMarks)
            {
                <div class="mark-properties-content"><h2>@(State.Selected?.IsMark == true ? "เครื่องหมายที่เลือก" : "วางเครื่องหมาย")</h2><p class="mark-subtitle">ปรับรูปแบบให้พอดีกับช่องในเอกสาร</p>
                <MarkChoices Value="@SelectedMarkKind" Disabled="@State.Busy" OnChange='value => Command("markKind", value)' />
                <div class="mark-property-fields"><div class="mark-size-field"><label for="mark-size">ขนาดเครื่องหมาย</label><div class="mark-stepper"><button aria-label="ลดขนาดเครื่องหมาย" disabled="@State.Busy" @onclick='() => Command("markSize", (SelectedMarkSize - 2).ToString())'>−</button><input id="mark-size" aria-label="ขนาดเครื่องหมาย" type="number" min="14" max="48" value="@SelectedMarkSize" disabled="@State.Busy" @onchange='e => Command("markSize", e.Value?.ToString())' /><button aria-label="เพิ่มขนาดเครื่องหมาย" disabled="@State.Busy" @onclick='() => Command("markSize", (SelectedMarkSize + 2).ToString())'>+</button></div></div>
                <div class="mark-color-field"><label>สี</label><div class="mark-swatches">@foreach (var color in MarkColors) { <button class="swatch-@color.Name @(SelectedMarkColor == color.Value ? "chosen" : "")" aria-label="@color.Label" aria-pressed="@(SelectedMarkColor == color.Value ? "true" : "false")" disabled="@State.Busy" @onclick='() => Command("markColor", color.Value)'></button> }</div></div></div>
                <label class="mark-continuous"><span>วางเครื่องหมายต่อเนื่อง</span><input type="checkbox" role="switch" aria-label="วางเครื่องหมายต่อเนื่อง" checked="@State.Continuous" disabled="@State.Busy" @onchange='e => Command("continuous", e.Value?.ToString()?.ToLowerInvariant())' /></label><p class="mark-helper">ใช้ขนาดและสีนี้กับเครื่องหมายถัดไป</p>
                <div class="mark-help"><p><Icon Name="move" /> ลากแถบเหนือเครื่องหมายเพื่อย้าย<br />ใช้ปุ่มลูกศรเพื่อขยับทีละนิด<br /><kbd>Esc</kbd> กลับไปโหมดเลือก</p></div>
                <div class="mark-mobile-actions"><button class="button button-quiet" disabled="@State.Busy" @onclick='() => Command("tool", "mark")'>+ วางอีก</button><button class="button button-blue" disabled="@State.Busy" @onclick='() => Command("finishMark")'>เสร็จ</button></div>
                <button class="button button-quiet mark-remove" disabled="@(State.Busy || State.Selected?.IsMark != true)" @onclick='() => Command("delete")'><Icon Name="trash" /> ลบเครื่องหมาย</button></div>
            }
            else
            {
            <div class="panel-title"><Icon Name="@(State.Selected?.IsSignature == true ? "pen" : "text")" /> @(State.Selected?.IsSignature == true ? "ลายเซ็น" : "ข้อความ")</div>
            @if (State.Selected is { IsSignature: true } signature)
            {
                <div class="properties-content"><h3>ลายเซ็นที่เลือก</h3><p class="field-help">ลากที่ลายเซ็นเพื่อย้ายตำแหน่ง<br />ลากมุมล่างขวาเพื่อปรับขนาดโดยคงสัดส่วน</p><label>ความกว้าง<input aria-label="ความกว้างลายเซ็น" type="number" min="20" value="@Math.Round(signature.Width)" @onchange='e => Patch("width", e.Value?.ToString())' /></label><button class="button delete-button" @onclick='() => Command("delete")'><Icon Name="trash" /> ลบลายเซ็น</button></div>
            }
            else if (State.Selected is { } selected)
            {
                <div class="properties-content"><label>ข้อความที่เลือก<textarea aria-label="ข้อความที่เลือก" value="@selected.Text" @onchange='e => Patch("text", e.Value?.ToString())' rows="4"></textarea></label><div class="font-field"><span>ฟอนต์</span><span class="read-only-font" aria-label="ฟอนต์ Sarabun">Sarabun · ภาษาไทย / English</span></div><div class="property-row"><label>ขนาดตัวอักษร<input aria-label="ขนาดตัวอักษร" type="number" min="8" max="72" value="@selected.Size" @onchange='e => Patch("size", e.Value?.ToString())' /></label><label>สีตัวอักษร<input aria-label="สีตัวอักษร" type="color" value="@selected.Color" @onchange='e => Patch("color", e.Value?.ToString())' /></label></div><div class="alignment-field"><span>การจัดแนว</span><Dropdown Label="การจัดแนว" Value="@selected.Align" Options="@AlignmentOptions" ValueChanged='value => Patch("align", value)' /></div><p class="field-help">คลิกแล้วลากเพื่อย้าย · ดับเบิลคลิกเพื่อแก้ข้อความ<br />ปรับขนาดตัวอักษรจากช่องด้านบน<br />กด Enter เพื่อขึ้นบรรทัดใหม่</p><button class="button delete-button" @onclick='() => Command("delete")'><Icon Name="trash" /> ลบข้อความ</button></div>
            }
            else
            {
                <div class="properties-empty"><span class="empty-icon"><Icon Name="cursor" /></span><h3>เลือกข้อความเพื่อแก้ไข</h3><p>หรือกด “เพิ่มข้อความ”<br />แล้วคลิกบนหน้าเอกสาร</p><button class="button button-soft" @onclick='() => Command("tool", "text")'><Icon Name="text" /> เพิ่มข้อความ</button></div>
            }
            }
            <div class="signature-library-panel" hidden="@ShowMarks"><div class="panel-title">ลายเซ็นของฉัน</div><div id="signature-library"></div><button class="button button-soft full" @onclick='() => Command("signature")' disabled="@State.Busy"><Icon Name="pen" /> เซ็นเอกสาร</button><p class="field-help">ลากลายเซ็นไปวาง หรือคลิกแล้วคลิกบน PDF<br />เก็บชั่วคราวจนกว่าจะปิดหน้านี้</p></div>
        </aside></div>
    <div class="editor-status"><span>@State.Count รายการ</span><span>@(State.Busy ? "กำลังประมวลผล…" : State.Shared ? (State.SharedClosed ? "เอกสารฉบับสุดท้าย · แก้ไขไม่ได้" : "ลายเซ็นร่างจะถูกส่งเมื่อกดยืนยัน") : State.Tool == "mark" ? "คลิกบนเอกสารเพื่อวางเครื่องหมาย · Esc เพื่อหยุด" : "คลิกเลือกรายการเพื่อแก้ไข")</span><span>ดาวน์โหลดงานก่อนปิดหน้านี้</span></div>
</div>
@if (!string.IsNullOrEmpty(State.Error))
{
    <div class="error-toast" role="alert"><span>@State.Error</span><button aria-label="ปิดข้อความแจ้งเตือน" @onclick='() => Command("clearError")'><Icon Name="close" /></button></div>
}
<dialog id="preview-dialog" aria-labelledby="preview-heading"><div class="preview-header"><div><h2 id="preview-heading">ตรวจเอกสารก่อนดาวน์โหลด</h2><p>ตัวอย่างจากไฟล์ PDF ที่จะดาวน์โหลดจริง</p></div><button class="tool" aria-label="ปิดตัวอย่าง" @onclick='() => Command("closePreview")'><Icon Name="close" /></button></div><div class="preview-toolbar"><button class="button button-quiet small" @onclick='() => Command("previewPrevious")'>หน้าก่อน</button><span id="preview-page-label"></span><button class="button button-quiet small" @onclick='() => Command("previewNext")'>หน้าถัดไป</button></div><p id="preview-password-note" class="preview-password-note" hidden>ไฟล์ที่ดาวน์โหลดนี้ไม่มีรหัสผ่าน ไฟล์ต้นฉบับยังเหมือนเดิม</p><div class="preview-body"><canvas id="preview-canvas"></canvas></div><div class="preview-footer"><button class="button button-quiet" @onclick='() => Command("closePreview")'>กลับไปแก้ไข</button><button class="button button-blue" @onclick='() => Command("download")'><Icon Name="download" /> ดาวน์โหลดไฟล์นี้</button></div></dialog>
<SignatureDialogs />
<SigningControls />
<div id="blazor-error-ui">เกิดข้อผิดพลาด กรุณาดาวน์โหลดงานถ้ายังทำได้ก่อนรีเฟรช <a href="/">โหลดหน้าใหม่</a></div>
@code {
    private IJSObjectReference? Module;
    private DotNetObjectReference<Editor>? Reference;
    private EditorState State = new();
    private bool Ready;
    private string ZoomValue => State.FitZoom ? "fit" : State.Zoom.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private IReadOnlyList<DropdownOption> ZoomOptions => AddCurrentZoom([new("fit", "พอดีหน้าจอ"), new("0.5", "50%"), new("0.75", "75%"), new("1", "100%"), new("1.25", "125%"), new("1.5", "150%"), new("2", "200%")]);
    private IReadOnlyList<DropdownOption> MobileZoomOptions => AddCurrentZoom([new("fit", "พอดี"), new("0.75", "75%"), new("1", "100%"), new("1.5", "150%"), new("2", "200%")]);
    private IReadOnlyList<DropdownOption> AddCurrentZoom(List<DropdownOption> options)
    {
        if (!State.FitZoom && !options.Any(option => option.Value == ZoomValue)) options.Add(new(ZoomValue, $"{Math.Round(State.Zoom * 100)}%"));
        return options;
    }
    private IReadOnlyList<DropdownOption> PageOptions => Enumerable.Range(1, State.Pages).Select(page => new DropdownOption(page.ToString(), $"{page} / {State.Pages}")).ToArray();
    private static readonly IReadOnlyList<DropdownOption> DateFormatOptions = [new("numeric", "ตัวเลข · วัน/เดือน/ปี"), new("short", "เดือนย่อ · 24 ก.ย."), new("long", "เดือนเต็ม · 24 กันยายน")];
    private static readonly IReadOnlyList<DropdownOption> AlignmentOptions = [new("left", "ชิดซ้าย"), new("center", "กึ่งกลาง"), new("right", "ชิดขวา")];
    private bool MarkMenu;
    private bool ShowDate => State.Tool == "date" || State.Selected?.Date is not null;
    private bool ShowMarks => State.Tool == "mark" || State.Selected?.IsMark == true;
    private string SelectedMarkKind => State.Selected?.IsMark == true ? State.Selected.Mark : State.MarkKind;
    private double SelectedMarkSize => State.Selected?.IsMark == true ? State.Selected.Size : State.MarkSize;
    private string SelectedMarkColor => State.Selected?.IsMark == true ? State.Selected.Color : State.MarkColor;
    private static readonly (string Name, string Value, string Label)[] MarkColors = [("black", "#172c40", "สีดำ"), ("blue", "#176ba8", "สีน้ำเงิน"), ("red", "#b13b36", "สีแดง")];
    private async Task ToggleMarks() { var open = !MarkMenu; if (State.Selected?.IsMark != true) await Command("tool", "mark"); MarkMenu = open; }
    private async Task ChooseMark(string kind) { MarkMenu = false; await Command("markKind", kind); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/index.js");
        Reference = DotNetObjectReference.Create(this);
        await Module.InvokeVoidAsync("init", Reference);
        Ready = true;
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public Task Changed(EditorState state) { State = state; if (state.Tool != "mark") MarkMenu = false; return InvokeAsync(StateHasChanged); }
    private async Task Pick() { if (Module is not null) await Module.InvokeVoidAsync("pick"); }
    private Task Close() => Command("close");
    private async Task Command(string action, string? value = null) { if (Module is not null) await Module.InvokeVoidAsync("command", action, value); }
    private async Task Patch(string key, string? value) { if (Module is not null) await Module.InvokeVoidAsync("patch", key, value); }
    public async ValueTask DisposeAsync() { if (Module is not null) { await Module.InvokeVoidAsync("dispose"); await Module.DisposeAsync(); } Reference?.Dispose(); }
    public sealed class EditorState
    {
        public DateOptions Date { get; set; } = new();
        public string DatePreview { get; set; } = "";
        public double DateSize { get; set; } = 16;
        public string DateColor { get; set; } = "#172433";
        public bool Shared { get; set; }
        public bool SharedClosed { get; set; }
        public bool SharedExpired { get; set; }
        public bool Loaded { get; set; }
        public bool Busy { get; set; }
        public string Filename { get; set; } = "";
        public string? Error { get; set; }
        public string Tool { get; set; } = "select";
        public int Pages { get; set; }
        public int Page { get; set; } = 1;
        public int Count { get; set; }
        public double Zoom { get; set; } = 1;
        public bool FitZoom { get; set; } = true;
        public string MarkKind { get; set; } = "check";
        public double MarkSize { get; set; } = 24;
        public string MarkColor { get; set; } = "#172c40";
        public bool Continuous { get; set; } = true;
        public bool CanUndo { get; set; }
        public bool CanRedo { get; set; }
        public SelectedText? Selected { get; set; }
    }
    public sealed class DateOptions
    {
        public string Value { get; set; } = "";
        public string Calendar { get; set; } = "buddhist";
        public string Format { get; set; } = "numeric";
    }
    public sealed class SelectedText
    {
        public DateOptions? Date { get; set; }
        public bool IsMark { get; set; }
        public string Mark { get; set; } = "check";
        public bool IsSignature { get; set; }
        public string Text { get; set; } = "";
        public double Size { get; set; }
        public string Color { get; set; } = "#172433";
        public string Align { get; set; } = "left";
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
