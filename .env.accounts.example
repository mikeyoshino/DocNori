# Docker Compose interpolation (copy values into your gitignored .env).
# Accounts require an HTTPS local origin for secure browser cookies.
# Dedicated local member-workspace database; use a random password.
ACCOUNTS_DEV_DB_PASSWORD=
ACCOUNTS_PUBLIC_ORIGIN=https://localhost:5443
ACCOUNTS_GOOGLE_CLIENT_ID=
ACCOUNTS_GOOGLE_CLIENT_SECRET=
ACCOUNTS_SMTP_HOST=
ACCOUNTS_SMTP_PORT=587
ACCOUNTS_SMTP_USER=
ACCOUNTS_SMTP_PASSWORD=
ACCOUNTS_SMTP_FROM=

# Direct dotnet run / production environment uses section names instead:
# Accounts__ConnectionString=Host=...;Database=...;Username=...;Password=...
# Accounts__PublicOrigin=https://docnori.com
# Accounts__DataProtectionPath=/keys
# Templates__StoragePath=/templates
# Accounts__Google__ClientId=...
# Accounts__Google__ClientSecret=...
# Accounts__Smtp__Host=...
# Accounts__Smtp__Port=587
# Accounts__Smtp__User=...
# Accounts__Smtp__Password=...
# Accounts__Smtp__From=...
