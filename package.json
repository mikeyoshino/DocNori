{
  "name": "sabuysign",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write 'src/SabuySign.Web/Client/**/*.ts' 'tests/**/*.ts' 'scripts/*.mjs'",
    "format:check": "prettier --check 'src/SabuySign.Web/Client/**/*.ts' 'tests/**/*.ts' 'scripts/*.mjs'"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.7.1",
    "heic-to": "1.5.2",
    "opentype.js": "2.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "perfect-freehand": "1.2.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/opentype.js": "1.3.10",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
